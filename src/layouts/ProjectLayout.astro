---
import Layout from './Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { Icon } from 'astro-icon/components';

interface Props {
  title: string;
  description: string;
  accent: string;
  tags: { name: string; icon: string; color: string }[];
  liveUrl?: string;
  repoUrl?: string;
  role?: string;
  challenges?: string[];
  learnings?: string[];
  contributions?: string[];
}

const {
  title,
  description,
  accent,
  tags,
  liveUrl,
  repoUrl,
  role,
  challenges,
  learnings,
  contributions,
} = Astro.props;
---

<Layout>
  <Navbar />

  <main class="relative min-h-screen">
    <!-- Background grid pattern -->
    <div class="absolute inset-0 opacity-[0.03]" style="background-image: radial-gradient(circle, #4a9eff 1px, transparent 1px); background-size: 24px 24px;"></div>

    <div class="relative mx-auto lg:max-w-4xl xl:max-w-6xl px-4 sm:px-6 py-12 sm:py-20">

      <!-- Back navigation -->
      <a
        href="/#works"
        class="group inline-flex items-center gap-2 mb-8 sm:mb-12 font-code text-xs sm:text-sm text-typography-secondary/50 transition-colors duration-200 hover:text-primary"
      >
        <Icon name="lucide:arrow-left" class="w-4 h-4 transition-transform duration-200 group-hover:-translate-x-1" />
        <span><span class="text-typography-secondary/30">cd</span> ~/projects</span>
      </a>

      <!-- Project header -->
      <header class="mb-10 sm:mb-16">
        <!-- Terminal-style header -->
        <div class="rounded-xl border border-border-color/60 bg-background-secondary overflow-hidden mb-8">
          <!-- Terminal bar -->
          <div class="flex items-center justify-between border-b border-border-color/40 px-4 sm:px-5 py-2.5 sm:py-3">
            <div class="flex items-center gap-2">
              <div class="flex gap-1.5">
                <span class="h-2.5 w-2.5 rounded-full bg-red-500/80"></span>
                <span class="h-2.5 w-2.5 rounded-full bg-amber-400/80"></span>
                <span class="h-2.5 w-2.5 rounded-full bg-success/80"></span>
              </div>
              <span class="font-code text-xs text-typography-secondary/40">
                ~/projects/{title.toLowerCase().replace(/\s+/g, '-')}/README.md
              </span>
            </div>
          </div>

          <div class="p-5 sm:p-8">
            <!-- Title with accent -->
            <div class="flex items-start gap-3 mb-4">
              <div
                class="mt-1.5 h-8 w-1.5 rounded-full shrink-0"
                style={`background: ${accent};`}
              ></div>
              <div>
                <h1 class="text-2xl sm:text-4xl font-bold text-typography-primary">{title}</h1>
                {role && (
                  <p class="mt-2 font-code text-xs sm:text-sm" style={`color: ${accent};`}>{role}</p>
                )}
              </div>
            </div>

            <p class="text-sm sm:text-base leading-relaxed text-typography-secondary/60 pl-[18px] sm:pl-[22px] max-w-2xl">
              {description}
            </p>

            <!-- Tags -->
            <div class="mt-5 flex flex-wrap gap-2 pl-[18px] sm:pl-[22px]">
              {tags.map((tag) => (
                <span class="inline-flex items-center gap-1.5 rounded-md border border-border-color/40 bg-background-primary/50 px-2.5 py-1 font-code text-[11px] text-typography-secondary/60">
                  <Icon name={tag.icon} class="w-3 h-3" style={`color: ${tag.color};`} />
                  {tag.name}
                </span>
              ))}
            </div>

            <!-- Links -->
            <div class="mt-5 flex items-center gap-4 pl-[18px] sm:pl-[22px]">
              {liveUrl && (
                <a
                  href={liveUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="group/link inline-flex items-center gap-1.5 font-code text-xs transition-colors duration-200"
                  style={`color: ${accent};`}
                >
                  <Icon name="lucide:external-link" class="w-3.5 h-3.5 transition-transform duration-200 group-hover/link:-translate-y-0.5 group-hover/link:translate-x-0.5" />
                  Live Demo
                </a>
              )}
              {repoUrl && (
                <a
                  href={repoUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="group/link inline-flex items-center gap-1.5 font-code text-xs text-typography-secondary/40 transition-colors duration-200 hover:text-typography-secondary"
                >
                  <Icon name="simple-icons:github" class="w-3.5 h-3.5" />
                  Source Code
                </a>
              )}
              {!liveUrl && !repoUrl && (
                <span class="font-code text-xs text-typography-secondary/30">
                  Proyecto privado
                </span>
              )}
            </div>
          </div>
        </div>
      </header>

      <!-- Info cards: challenges, learnings, contributions -->
      {(challenges?.length || learnings?.length || contributions?.length) && (
        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3 mb-10 sm:mb-16">
          {challenges && challenges.length > 0 && (
            <div class="rounded-xl border border-border-color/60 bg-background-secondary p-5">
              <div class="flex items-center gap-2 mb-3">
                <Icon name="lucide:zap" class="w-4 h-4 text-amber-400" />
                <h3 class="font-code text-sm font-semibold text-typography-primary">Retos</h3>
              </div>
              <ul class="space-y-2">
                {challenges.map((c) => (
                  <li class="flex items-start gap-2 text-xs leading-relaxed text-typography-secondary/50">
                    <span class="mt-1 h-1 w-1 rounded-full bg-amber-400/60 shrink-0"></span>
                    {c}
                  </li>
                ))}
              </ul>
            </div>
          )}

          {learnings && learnings.length > 0 && (
            <div class="rounded-xl border border-border-color/60 bg-background-secondary p-5">
              <div class="flex items-center gap-2 mb-3">
                <Icon name="lucide:lightbulb" class="w-4 h-4 text-primary" />
                <h3 class="font-code text-sm font-semibold text-typography-primary">Aprendizajes</h3>
              </div>
              <ul class="space-y-2">
                {learnings.map((l) => (
                  <li class="flex items-start gap-2 text-xs leading-relaxed text-typography-secondary/50">
                    <span class="mt-1 h-1 w-1 rounded-full bg-primary/60 shrink-0"></span>
                    {l}
                  </li>
                ))}
              </ul>
            </div>
          )}

          {contributions && contributions.length > 0 && (
            <div class="rounded-xl border border-border-color/60 bg-background-secondary p-5">
              <div class="flex items-center gap-2 mb-3">
                <Icon name="lucide:git-commit-horizontal" class="w-4 h-4 text-success" />
                <h3 class="font-code text-sm font-semibold text-typography-primary">Aportes</h3>
              </div>
              <ul class="space-y-2">
                {contributions.map((c) => (
                  <li class="flex items-start gap-2 text-xs leading-relaxed text-typography-secondary/50">
                    <span class="mt-1 h-1 w-1 rounded-full bg-success/60 shrink-0"></span>
                    {c}
                  </li>
                ))}
              </ul>
            </div>
          )}
        </div>
      )}

      <!-- Markdown content -->
      <article class="prose-project rounded-xl border border-border-color/60 bg-background-secondary p-5 sm:p-8">
        <slot />
      </article>

      <!-- Bottom navigation -->
      <div class="mt-10 sm:mt-16 flex justify-center">
        <a
          href="/#works"
          class="group inline-flex items-center gap-2 rounded-lg border border-border-color/40 bg-background-secondary/50 px-5 py-2.5 font-code text-xs text-typography-secondary/50 transition-all duration-200 hover:border-primary/40 hover:text-primary"
        >
          <Icon name="lucide:arrow-left" class="w-3.5 h-3.5 transition-transform duration-200 group-hover:-translate-x-1" />
          Ver todos los proyectos
        </a>
      </div>
    </div>
  </main>

  <Footer />
</Layout>
