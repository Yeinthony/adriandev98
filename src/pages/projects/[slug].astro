---
import { getCollection, render } from 'astro:content';
import ProjectLayout from '../../layouts/ProjectLayout.astro';

export async function getStaticPaths() {
  const all = await getCollection('projects');
  // Las entradas en inglés usan el slug con sufijo "-en" (repomap-en)
  const esEntries = all.filter((entry) => !entry.id.endsWith('-en'));
  return esEntries.map((es) => {
    const en = all.find((entry) => entry.id === `${es.id}-en`) ?? es;
    return { params: { slug: es.data.slug }, props: { es, en } };
  });
}

const { es, en } = Astro.props;
const { Content: EsContent } = await render(es);
const { Content: EnContent } = await render(en);
---

<ProjectLayout es={es.data} en={en.data}>
  <EsContent slot="es" />
  <EnContent slot="en" />
</ProjectLayout>
