---
import { Icon } from 'astro-icon/components';
import T from './i18n/T.astro';

const footerLinks = [
  { icon: 'simple-icons:github', href: 'https://github.com/Yeinthony', label: 'GitHub' },
  { icon: 'simple-icons:linkedin', href: 'https://www.linkedin.com/in/yeinthony-vargas-2a9274385/', label: 'LinkedIn' },
  { icon: 'simple-icons:instagram', href: 'https://www.instagram.com/adriandev.98?igsh=MTNkaDV4YmJpbnk1Mg==', label: 'Instagram' },
];
---

<footer class="relative border-t border-border-color/60 bg-background-secondary/50 pb-28 sm:pb-22 md:pb-14">
  <!-- Background dot pattern -->
  <div class="absolute inset-0 opacity-[0.02]" style="background-image: radial-gradient(circle, #4a9eff 1px, transparent 1px); background-size: 24px 24px;"></div>

  <div class="relative mx-auto lg:max-w-4xl xl:max-w-6xl px-4 sm:px-6 py-8 sm:py-10">
    <!-- Top row -->
    <div class="flex flex-col items-center gap-6 md:flex-row md:justify-between">
      <!-- Logo -->
      <a href="#home" class="group flex items-center gap-2.5">
        <div class="flex h-7 w-7 items-center justify-center rounded-lg border border-primary/30 bg-primary/10 transition-all duration-300 group-hover:border-primary/60 group-hover:bg-primary/15">
          <span class="font-code text-[10px] font-bold text-primary">{'</>'}</span>
        </div>
        <div class="flex items-center">
          <span class="font-code text-xs font-semibold text-typography-primary transition-colors duration-300 group-hover:text-white">
            AdrianDev
          </span>
          <span class="font-code text-xs text-primary/60 transition-colors duration-300 group-hover:text-primary">
            .98
          </span>
        </div>
      </a>

      <!-- Social icons -->
      <div class="flex items-center gap-2">
        {footerLinks.map(({ icon, href, label }) => (
          <a
            href={href}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={label}
            class="group flex h-8 w-8 items-center justify-center rounded-lg border border-border-color/40 bg-background-primary/50 transition-all duration-300 hover:border-primary/40 hover:-translate-y-0.5"
          >
            <Icon name={icon} class="w-3.5 h-3.5 text-typography-secondary/40 transition-all duration-300 group-hover:text-primary" />
          </a>
        ))}
      </div>

      <!-- Copyright -->
      <span class="font-code text-[10px] sm:text-xs text-typography-secondary/30">
        {`© ${new Date().getFullYear()} Adrian Vargas`}
      </span>
    </div>

    <!-- Divider -->
    <div class="h-px bg-border-color/30 my-5 sm:my-6"></div>

    <!-- Bottom terminal line -->
    <div class="flex flex-col sm:flex-row items-center justify-between gap-3 font-code text-[10px] sm:text-[11px]">
      <p class="flex items-center gap-1.5 text-typography-secondary/30">
        <span class="text-success">$</span>
        <span>built_with</span>
        <Icon name="lucide:heart" class="w-3 h-3 text-red-400/60" />
        <span class="text-typography-secondary/20">&&</span>
        <span class="text-primary/50"><T es="muchas papas fritas" en="lots of fries" /></span>
      </p>
      <div class="flex items-center gap-2 text-typography-secondary/20">
        <span>Astro</span>
        <span class="text-border-color">·</span>
        <span>Tailwind</span>
        <span class="text-border-color">·</span>
        <span>TypeScript</span>
      </div>
    </div>
  </div>
</footer>
