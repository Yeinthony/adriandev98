---
import { GitBranch, CircleCheckBig, Wifi, Heart } from '@lucide/astro';
---

<footer class="border-t border-border-color bg-background-secondary py-8 pb-14">
  <div class="mx-auto max-w-7xl px-6">
    <div class="flex flex-col items-center justify-between gap-4 md:flex-row">
      <div class="flex items-center gap-2">
        <div
          class="flex h-7 w-7 items-center justify-center rounded-md bg-primary font-mono text-xs font-bold text-secondary-primary"
        >
          {'</>'}
        </div>
        <span class="font-mono text-sm text-typography-secondary/60"> AdrianDev.98 </span>
      </div>

      <p class="flex items-center gap-1.5 font-mono text-xs text-typography-secondary/40">
        Crafted with <Heart size={12} class="text-red-400" /> and lots of coffee
      </p>

      <span class="font-mono text-xs text-typography-secondary/30">
        {`© ${new Date().getFullYear()} Adrian Vargas`}
      </span>
    </div>
  </div>
</footer>
