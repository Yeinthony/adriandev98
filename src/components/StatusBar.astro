---
import { Icon } from 'astro-icon/components';

const projects = ['Isipay', 'Godrive', 'SIGMIG', 'Listify', 'Portafolio'];
const stacks = [
  { project: 'Isipay', stack: 'ReactNative · Zustand · TypeScript · TailwindCSS' },
  { project: 'Godrive', stack: 'Nuxt · TypeScript · Vuetify · Pinia' },
  { project: 'SIGMIG', stack: 'Vue3 · TypeScript · Vuetify · Pinia' },
  { project: 'Listify', stack: 'ReactNative · NestJS · TypeScript' },
  { project: 'Portafolio', stack: 'Astro · TypeScript · TailwindCSS' },
];
---

<div
  class="fixed bottom-0 left-0 right-0 z-40 border-t border-border-color/60 bg-background-secondary/95 backdrop-blur-md font-code text-[10px] sm:text-[11px]"
>
  <div class="flex items-center justify-between px-3 sm:px-4 py-1.5">
    <!-- Left side -->
    <div class="flex items-center gap-3 sm:gap-4">
      <!-- Branch -->
      <span class="flex items-center gap-1.5 text-primary/80">
        <Icon name="lucide:git-branch" class="w-3 h-3" />
        <span class="hidden sm:inline">main</span>
      </span>

      <!-- Status -->
      <span class="flex items-center gap-1.5 text-typography-secondary/50">
        <Icon name="lucide:circle-check-big" class="w-3 h-3 text-success/70" />
        <span class="hidden sm:inline">0 problemas</span>
      </span>

      <!-- Separator -->
      <div class="hidden md:block h-3 w-px bg-border-color/40"></div>

      <!-- Working on -->
      <div class="hidden md:flex items-center gap-1.5 text-typography-secondary/40">
        <Icon name="lucide:folder-code" class="w-3 h-3 text-primary/40" />
        <span>proyecto:</span>
        <div class="relative">
          <button
            id="dropdown-button"
            class="flex items-center gap-1 text-primary/80 hover:text-primary transition-colors duration-200 cursor-pointer"
          >
            <span id="selected-project">Isipay</span>
            <Icon name="lucide:chevron-up" class="w-2.5 h-2.5 opacity-50" />
          </button>

          <ul
            id="dropdown-menu"
            class="absolute z-50 bottom-full mb-2 left-0 min-w-[140px] rounded-lg border border-border-color/60 bg-background-secondary shadow-xl shadow-black/30 overflow-hidden hidden"
          >
            {projects.map((project, i) => (
              <li
                class="dropdown-item px-3 py-1.5 font-code text-[11px] text-typography-secondary/60 hover:bg-primary/10 hover:text-primary cursor-pointer transition-colors duration-150"
                data-value={project}
              >
                <span class="text-typography-secondary/20 mr-1.5">{String(i + 1).padStart(2, '0')}</span>
                {project}
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>

    <!-- Right side -->
    <div class="flex items-center gap-3 sm:gap-4 text-typography-secondary/40">
      <!-- Stack -->
      <span id="stack" class="hidden lg:inline text-typography-secondary/25">
        ReactNative · Zustand · TypeScript · TailwindCSS
      </span>

      <!-- Separator -->
      <div class="hidden lg:block h-3 w-px bg-border-color/40"></div>

      <!-- Online status -->
      <span class="flex items-center gap-1.5">
        <span class="inline-block h-1.5 w-1.5 rounded-full bg-success/70 animate-pulse"></span>
        <span class="hidden sm:inline">En línea</span>
      </span>

      <!-- TypeScript -->
      <span class="hidden sm:flex items-center gap-1.5 text-typography-secondary/30">
        <Icon name="simple-icons:typescript" class="w-3 h-3 text-[#3178c6]/50" />
        TS
      </span>
    </div>
  </div>
</div>

<script id="stacks-data" type="application/json" data-stacks={JSON.stringify(stacks)}></script>

<script>
  const button = document.getElementById('dropdown-button');
  const menu = document.getElementById('dropdown-menu');
  const selectedProject = document.getElementById('selected-project');
  const stackSpan = document.getElementById('stack');
  const items = document.querySelectorAll('.dropdown-item');

  const stacksData = document.getElementById('stacks-data');
  const stacks = stacksData ? JSON.parse(stacksData.getAttribute('data-stacks') || '[]') : [];

  function getStackForProject(projectName: string): string {
    const project = stacks.find((s: any) => s.project === projectName);
    return project ? project.stack : 'Stack no disponible';
  }

  function updateProjectDisplay(projectName: string) {
    if (selectedProject) {
      selectedProject.textContent = projectName;
    }
    if (stackSpan) {
      stackSpan.textContent = getStackForProject(projectName);
    }
  }

  let currentProject = 'Isipay';
  const savedProject = localStorage.getItem('selectedProject');

  if (savedProject) {
    currentProject = savedProject;
  }

  updateProjectDisplay(currentProject);

  button?.addEventListener('click', (e) => {
    e.stopPropagation();
    menu?.classList.toggle('hidden');
  });

  items.forEach((item) => {
    item.addEventListener('click', () => {
      const value = item.getAttribute('data-value');
      if (value) {
        currentProject = value;
        updateProjectDisplay(value);
        localStorage.setItem('selectedProject', value);
        menu?.classList.add('hidden');
      }
    });
  });

  document.addEventListener('click', (e) => {
    if (!button?.contains(e.target as Node) && !menu?.contains(e.target as Node)) {
      menu?.classList.add('hidden');
    }
  });
</script>
