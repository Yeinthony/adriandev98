---
import Bracket from './codeSnippets/Bracket.astro';
import CodeLine from './codeSnippets/CodeLine.astro';
import CodeSnippet from './codeSnippets/CodeSnippet.astro';
import Comment from './codeSnippets/Comment.astro';
import FuncName from './codeSnippets/FuncName.astro';
import Keyword from './codeSnippets/Keyword.astro';
import Param from './codeSnippets/Param.astro';
import StringVal from './codeSnippets/StringVal.astro';
---

<section class="relative flex min-h-screen items-center overflow-hidden pt-30 pb-32" id="hero">
  <div class="mx-auto grid max-w-7xl items-center gap-12 px-6 lg:grid-cols-2 lg:gap-20">
    <div class="animate-fade-in-up">
      <div
        class="mb-6 inline-flex items-center gap-2 rounded-full border border-[#1a2d42] bg-[#0d1b2a] px-4 py-2"
      >
        <span class="h-2 w-2 rounded-full bg-[#28c840] animate-pulse"></span>
        <span class="font-mono text-xs text-[#d4e4f4]"> Available for freelance work </span>
      </div>

      <h1 class="mb-2 font-mono text-lg text-[#4a9eff]">
        {"Hello World! I'm"}
      </h1>

      <CodeSnippet filename="about-me.astro" class="mb-8 max-w-md">
        <CodeLine number={1}>
          <Keyword>const</Keyword>
          <FuncName>developer</FuncName>
          <Bracket>= {'{'}</Bracket>
        </CodeLine>
        <CodeLine number={2}>
          <Param>name</Param>: <StringVal>{'"Adrian Vargas"'}</StringVal>,
        </CodeLine>
        <CodeLine number={3}>
          <Param>role</Param>: <StringVal>{'"Frontend Dev"'}</StringVal>,
        </CodeLine>
        <CodeLine number={4}>
          <Param> loves</Param>: <StringVal>{'"Clean code"'}</StringVal>,
        </CodeLine>
        <CodeLine number={5}>
          <Comment>{' // Open to new opportunities!'}</Comment>
        </CodeLine>
        <CodeLine number={6}>
          <Bracket>{'}'}</Bracket>;
        </CodeLine>
      </CodeSnippet>

      <p class="mb-8 max-w-lg leading-relaxed text-[#d4e4f4]/80">
        I craft pixel-perfect, accessible web experiences using React, TypeScript, and modern CSS.
        Passionate about turning complex problems into elegant, intuitive interfaces.
      </p>
    </div>
    <div>
      <p class="text-primary font-code text-2xl">Hola</p>
    </div>
  </div>
</section>

<style>
  #hero {
  }
</style>
