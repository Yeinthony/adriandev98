---
import { Icon } from 'astro-icon/components';
import AButton from '../ui/buttons/AButton.astro';

const contactInfo = [
  { icon: 'lucide:mail', label: 'Email', value: 'adriandev98@gmail.com', color: '#4a9eff' },
  { icon: 'lucide:map-pin', label: 'Location', value: 'Buenos Aires, Argentina', color: '#28c840' },
  { icon: 'simple-icons:linkedin', label: 'LinkedIn', value: '/in/adriandev98', color: '#0a66c2' },
  { icon: 'simple-icons:github', label: 'GitHub', value: '@adriandev98', color: '#d4e4f4' },
];
---

<section id="contact" class="section-reveal relative py-20 sm:py-28 pb-32 sm:pb-40 overflow-hidden">
  <!-- Background grid pattern -->
  <div class="absolute inset-0 opacity-[0.03]" style="background-image: radial-gradient(circle, #4a9eff 1px, transparent 1px); background-size: 24px 24px;"></div>

  <!-- Ambient glow -->
  <div class="absolute bottom-0 left-1/2 -translate-x-1/2 w-[500px] h-[400px] rounded-full opacity-[0.03] blur-[100px]" style="background: #4a9eff;"></div>

  <div class="relative mx-auto lg:max-w-4xl xl:max-w-6xl px-4 sm:px-6">
    <!-- Section header -->
    <div class="mb-10 sm:mb-16">
      <span class="mb-2 block font-code text-xs sm:text-sm text-primary">
        {'// 03. Get In Touch'}
      </span>
      <h2 class="text-3xl sm:text-4xl font-bold text-typography-primary">Contacto</h2>
      <p class="mt-3 max-w-lg text-sm text-typography-secondary/60 font-code">
        <span class="text-success">$</span> ping adrian@dev <span class="text-typography-secondary/30">--message</span>
      </p>
    </div>

    <div class="grid gap-6 sm:gap-8 lg:grid-cols-5">
      <!-- Left: Info cards -->
      <div class="lg:col-span-2 flex flex-col gap-3 sm:gap-4">
        <!-- Description card -->
        <div class="contact-fade rounded-xl border border-border-color/60 bg-background-secondary p-4 sm:p-5" style="--delay: 0s;">
          <p class="text-xs sm:text-sm leading-relaxed text-typography-secondary/60">
            ¿Tienes un proyecto en mente o simplemente quieres hablar sobre desarrollo frontend?
            Me encantaría saber de ti. Construyamos algo genial juntos.
          </p>
        </div>

        <!-- Contact info cards -->
        {contactInfo.map((item, i) => (
          <div
            class="contact-fade group flex items-center gap-3 rounded-xl border border-border-color/60 bg-background-secondary p-3 sm:p-4 transition-all duration-300 hover:border-transparent cursor-default"
            style={`--delay: ${(i + 1) * 0.07}s;`}
          >
            <!-- Hover glow -->
            <div
              class="absolute inset-0 rounded-xl opacity-0 transition-opacity duration-300 group-hover:opacity-100 pointer-events-none"
              style={`background: radial-gradient(ellipse at left, ${item.color}08 0%, transparent 60%); border: 1px solid ${item.color}25;`}
            ></div>
            <div
              class="relative flex h-9 w-9 sm:h-10 sm:w-10 shrink-0 items-center justify-center rounded-lg transition-all duration-300 group-hover:scale-105"
              style={`background: ${item.color}10;`}
            >
              <Icon name={item.icon} class="w-4 h-4 sm:w-[18px] sm:h-[18px] transition-all duration-300" style={`color: ${item.color}90;`} />
            </div>
            <div class="relative">
              <div class="font-code text-[9px] sm:text-[10px] text-typography-secondary/40">
                {item.label}
              </div>
              <div class="font-code text-[11px] sm:text-xs text-typography-primary group-hover:text-white transition-colors duration-300">
                {item.value}
              </div>
            </div>
          </div>
        ))}

        <!-- Terminal response -->
        <div class="contact-fade rounded-xl border border-border-color/40 bg-background-secondary/50 px-3 sm:px-4 py-2.5 sm:py-3" style="--delay: 0.4s;">
          <div class="flex flex-col gap-1.5 font-code text-[10px] sm:text-[11px]">
            <div class="flex items-center gap-2">
              <span class="text-success">$</span>
              <span class="text-typography-secondary/40">response_time:</span>
              <span class="text-primary">&lt; 24h</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="text-success">$</span>
              <span class="text-typography-secondary/40">availability:</span>
              <span class="text-success">● online</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Right: Form -->
      <div class="lg:col-span-3 contact-fade" style="--delay: 0.15s;">
        <div class="rounded-xl border border-border-color/60 bg-background-secondary overflow-hidden">
          <!-- Terminal header -->
          <div class="flex items-center justify-between border-b border-border-color/40 px-4 sm:px-5 py-2.5 sm:py-3">
            <div class="flex items-center gap-2">
              <div class="flex gap-1.5">
                <span class="h-2 w-2 sm:h-2.5 sm:w-2.5 rounded-full bg-red-500/80"></span>
                <span class="h-2 w-2 sm:h-2.5 sm:w-2.5 rounded-full bg-amber-400/80"></span>
                <span class="h-2 w-2 sm:h-2.5 sm:w-2.5 rounded-full bg-success/80"></span>
              </div>
              <span class="font-code text-[10px] sm:text-xs text-typography-secondary/40">
                ~/contact-form.tsx
              </span>
            </div>
            <div class="flex items-center gap-1.5">
              <span class="inline-block h-1.5 w-1.5 rounded-full bg-success"></span>
              <span class="font-code text-[9px] sm:text-[10px] text-typography-secondary/30">ready</span>
            </div>
          </div>

          <!-- Success message -->
          <div
            id="contact-success"
            class="hidden flex-col items-center justify-center py-12 sm:py-16 text-center px-4"
          >
            <div class="mb-4 flex h-14 w-14 sm:h-16 sm:w-16 items-center justify-center rounded-full bg-success/10">
              <Icon name="lucide:check-circle-2" class="w-6 h-6 sm:w-8 sm:h-8 text-success" />
            </div>
            <p class="font-code text-xs sm:text-sm text-success mb-1">
              ¡Mensaje enviado con éxito!
            </p>
            <p class="font-code text-[10px] sm:text-xs text-typography-secondary/40">
              Te responderé en menos de 24 horas.
            </p>
            <div class="mt-4 font-code text-[10px] text-typography-secondary/30">
              <span class="text-success">✓</span> deliver(from, message) → <span class="text-primary">200 OK</span>
            </div>
          </div>

          <!-- Form -->
          <form id="contact-form" class="p-4 sm:p-6 flex flex-col gap-4 sm:gap-5">
            <!-- Name & Email row -->
            <div class="grid gap-4 sm:gap-5 sm:grid-cols-2">
              <div>
                <label for="contact-name" class="mb-1.5 flex items-center gap-1.5 font-code text-[10px] sm:text-[11px] text-typography-secondary/50">
                  <span class="text-primary/40">//</span> Tu nombre
                </label>
                <input
                  id="contact-name"
                  type="text"
                  required
                  placeholder="John Doe"
                  class="w-full rounded-lg border border-border-color/50 bg-background-primary px-3 sm:px-4 py-2.5 sm:py-3 font-code text-[11px] sm:text-xs text-typography-primary placeholder-typography-secondary/25 transition-all duration-200 focus:border-primary/50 focus:shadow-[0_0_0_3px_rgba(74,158,255,0.08)] focus:outline-none"
                />
              </div>
              <div>
                <label for="contact-email" class="mb-1.5 flex items-center gap-1.5 font-code text-[10px] sm:text-[11px] text-typography-secondary/50">
                  <span class="text-primary/40">//</span> Tu email
                </label>
                <input
                  id="contact-email"
                  type="email"
                  required
                  placeholder="john@example.com"
                  class="w-full rounded-lg border border-border-color/50 bg-background-primary px-3 sm:px-4 py-2.5 sm:py-3 font-code text-[11px] sm:text-xs text-typography-primary placeholder-typography-secondary/25 transition-all duration-200 focus:border-primary/50 focus:shadow-[0_0_0_3px_rgba(74,158,255,0.08)] focus:outline-none"
                />
              </div>
            </div>

            <!-- Subject -->
            <div>
              <label for="contact-subject" class="mb-1.5 flex items-center gap-1.5 font-code text-[10px] sm:text-[11px] text-typography-secondary/50">
                <span class="text-primary/40">//</span> Asunto
              </label>
              <input
                id="contact-subject"
                type="text"
                required
                placeholder="Tengo un proyecto en mente..."
                class="w-full rounded-lg border border-border-color/50 bg-background-primary px-3 sm:px-4 py-2.5 sm:py-3 font-code text-[11px] sm:text-xs text-typography-primary placeholder-typography-secondary/25 transition-all duration-200 focus:border-primary/50 focus:shadow-[0_0_0_3px_rgba(74,158,255,0.08)] focus:outline-none"
              />
            </div>

            <!-- Message -->
            <div>
              <label for="contact-message" class="mb-1.5 flex items-center gap-1.5 font-code text-[10px] sm:text-[11px] text-typography-secondary/50">
                <span class="text-primary/40">//</span> Tu mensaje
              </label>
              <textarea
                id="contact-message"
                required
                rows="5"
                placeholder="Cuéntame sobre tu proyecto, idea o simplemente saluda..."
                class="w-full resize-none rounded-lg border border-border-color/50 bg-background-primary px-3 sm:px-4 py-2.5 sm:py-3 font-code text-[11px] sm:text-xs text-typography-primary placeholder-typography-secondary/25 transition-all duration-200 focus:border-primary/50 focus:shadow-[0_0_0_3px_rgba(74,158,255,0.08)] focus:outline-none"
              ></textarea>
            </div>

            <!-- Submit -->
            <div class="flex items-center justify-between">
              <span class="font-code text-[9px] sm:text-[10px] text-typography-secondary/25">
                * todos los campos son requeridos
              </span>
              <AButton type="submit" text="Enviar mensaje" variant="gradient" size="sm" icon="lucide:send" />
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .contact-fade {
    animation: contact-in 0.4s ease-out both;
    animation-delay: var(--delay);
  }

  @keyframes contact-in {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Contact info cards need relative for glow */
  .contact-fade:has([class*="group"]) {
    position: relative;
  }

  .contact-fade .group {
    position: relative;
  }
</style>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const success = document.getElementById('contact-success')!;

  form.addEventListener('submit', (e) => {
    e.preventDefault();

    form.classList.add('hidden');
    success.classList.remove('hidden');
    success.classList.add('flex');

    setTimeout(() => {
      success.classList.add('hidden');
      success.classList.remove('flex');
      form.classList.remove('hidden');
      form.reset();
    }, 3000);
  });
</script>
