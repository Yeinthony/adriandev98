---
// src/components/Navbar.astro
import { Menu, X } from '@lucide/astro';
import AButton from './ui/buttons/AButton.astro';

const navLinks = [
  { label: 'Inicio', href: '#home' },
  { label: 'Trabajos', href: '#works' },
  { label: 'Sobre mi', href: '#about' },
  { label: 'Contacto', href: '#contact' },
];
---

<nav
  class="fixed top-0 left-0 right-0 z-50 border-b border-border-color bg-background-primary/90 backdrop-blur-md"
>
  <div class="mx-auto flex max-w-7xl items-center justify-between px-6 py-4">
    <a href="#home" class="flex items-center gap-2">
      <div
        class="flex h-8 w-8 items-center justify-center rounded-lg bg-primary font-mono text-sm font-bold text-background-primary"
      >
        {'</>'}
      </div>
      <span class="font-mono text-sm font-semibold text-typography-primary"> AdrianDev.98</span>
    </a>

    <div class="hidden items-center gap-1 md:flex">
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            class="rounded-lg px-4 py-2 font-mono text-sm text-typography-primary transition-colors hover:bg-border-color hover:text-primary]"
          >
            {link.label}
          </a>
        ))
      }
    </div>

    <AButton size="sm" text="Hablemos" />

    <button
      id="mobile-menu-button"
      class="rounded-lg p-2 text-typography-secondary transition-colors hover:bg-background-secondary md:hidden"
      aria-label="Toggle menu"
      aria-expanded="false"
    >
      <Menu class="menu-open w-5 h-5" />
      <X class="menu-close w-5 h-5 hidden" />
    </button>
  </div>

  <div
    id="mobile-menu"
    class="hidden border-t border-border-color bg-background-primary px-6 pb-6 md:hidden"
  >
    {
      navLinks.map((link) => (
        <a
          href={link.href}
          class="mobile-link block rounded-lg px-4 py-3 font-mono text-sm text-typography-secondary transition-colors hover:bg-background-secondary hover:text-primary"
        >
          {link.label}
        </a>
      ))
    }
    <a
      href="#contact"
      class="mobile-link mt-3 block rounded-xl bg-primary px-5 py-2.5 text-center font-mono text-sm font-semibold text-background-primary"
    >
      Let's Talk
    </a>
  </div>
</nav>

<script>
  const menuButton = document.getElementById('mobile-menu-button');
  const mobileMenu = document.getElementById('mobile-menu');
  const menuOpen = document.querySelector('.menu-open');
  const menuClose = document.querySelector('.menu-close');
  const mobileLinks = document.querySelectorAll('.mobile-link');

  function toggleMenu() {
    const isOpen = mobileMenu?.classList.contains('hidden');

    if (isOpen) {
      mobileMenu?.classList.remove('hidden');
      menuOpen?.classList.add('hidden');
      menuClose?.classList.remove('hidden');
      menuButton?.setAttribute('aria-expanded', 'true');
    } else {
      mobileMenu?.classList.add('hidden');
      menuOpen?.classList.remove('hidden');
      menuClose?.classList.add('hidden');
      menuButton?.setAttribute('aria-expanded', 'false');
    }
  }

  menuButton?.addEventListener('click', toggleMenu);

  // Cerrar menú al hacer click en un link
  mobileLinks.forEach((link) => {
    link.addEventListener('click', () => {
      mobileMenu?.classList.add('hidden');
      menuOpen?.classList.remove('hidden');
      menuClose?.classList.add('hidden');
      menuButton?.setAttribute('aria-expanded', 'false');
    });
  });
</script>
