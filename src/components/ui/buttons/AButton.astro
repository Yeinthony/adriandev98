---
// src/components/AnimatedButton.astro
import { Icon } from 'astro-icon/components';

interface Props {
  text?: string;
  href?: string;
  variant?: 'gradient' | 'primary' | 'secondary';
  size?: 'sm' | 'md' | 'lg';
  class?: string;
  icon?: string;
  iconPosition?: 'left' | 'right';
  showDefaultIcon?: boolean;
  type?: 'button' | 'submit' | 'reset';
  disabled?: boolean;
  id?: string;
  block?: boolean;
  target?: '_blank' | '_self' | '_parent' | '_top';
  rel?: string;
  download?: string | boolean;
}

const {
  text = "Let's get started",
  href,
  variant = 'gradient',
  size = 'md',
  class: className = '',
  icon,
  iconPosition = 'right',
  showDefaultIcon = true,
  type = 'button',
  disabled = false,
  id,
  block = false,
  target,
  rel,
  download,
  ...rest
} = Astro.props;

// Variantes de gradiente
const gradients = {
  gradient: 'from-primary via-blue-500 to-secondary',
  primary: 'from-primary via-primary to-primary',
  secondary: 'from-secondary via-secondary to-secondary',
};

// Tamaños
const sizes = {
  sm: 'px-4 py-2 text-sm',
  md: 'px-6 py-3 text-base',
  lg: 'px-8 py-4 text-lg',
};

const iconSizes = {
  sm: 16,
  md: 20,
  lg: 24,
};

const gradientClass = gradients[variant];
const sizeClass = sizes[size];
const iconSize = iconSizes[size];

const showIcon = icon || showDefaultIcon;
const defaultIcon = 'mdi:arrow-right';

const blockClass = block ? 'w-full' : '';
const buttonDisplayClass = block ? 'w-full block' : 'inline-block';
const hoverScale = block ? '' : 'hover:scale-102 active:scale-100';
---

<div class={`relative group ${blockClass} ${className}`}>
  {
    href ? (
      <a
        href={href}
        target={target}
        rel={rel ?? (target === '_blank' ? 'noopener noreferrer' : undefined)}
        download={download}
        data-button-id={id}
        class={`animated-button relative ${buttonDisplayClass} p-px font-semibold leading-6 text-typography-secondary bg-border-color cursor-pointer rounded-xl transition-transform duration-300 ease-in-out ${hoverScale} ${disabled ? 'pointer-events-none opacity-50' : ''}`}
        aria-disabled={disabled}
        {...rest}
      >
        <span
          class={`absolute inset-0 rounded-xl bg-linear-to-r ${gradientClass} p-0.5 opacity-0 transition-opacity duration-500 group-hover:opacity-100`}
        />

        <span class={`relative z-10 block rounded-xl bg-background-secondary ${sizeClass}`}>
          <div
            class={`relative z-10 flex items-center justify-center gap-2 ${iconPosition === 'left' ? 'flex-row-reverse' : ''}`}
          >
            <span class="transition-all duration-500 group-hover:translate-x-1"><slot>{text}</slot></span>
            {showIcon && (
              <Icon
                name={icon || defaultIcon}
                size={iconSize}
                class="transition-transform duration-500 group-hover:translate-x-1"
              />
            )}
          </div>
        </span>
      </a>
    ) : (
      <button
        type={type}
        disabled={disabled}
        data-button-id={id}
        class={`animated-button relative ${buttonDisplayClass} p-px font-semibold leading-6 text-typography-secondary bg-border-color cursor-pointer rounded-xl transition-transform duration-300 ease-in-out ${hoverScale} ${disabled ? 'cursor-not-allowed opacity-50' : ''}`}
        {...rest}
      >
        <span
          class={`absolute inset-0 rounded-xl bg-linear-to-r ${gradientClass} p-0.5 opacity-0 transition-opacity duration-500 group-hover:opacity-100`}
        />

        <span class={`relative z-10 block rounded-xl bg-background-secondary ${sizeClass}`}>
          <div
            class={`relative z-10 flex items-center justify-center gap-2 ${iconPosition === 'left' ? 'flex-row-reverse' : ''}`}
          >
            <span class="transition-all duration-500 group-hover:translate-x-1"><slot>{text}</slot></span>
            {showIcon && (
              <Icon
                name={icon || defaultIcon}
                size={iconSize}
                class="transition-transform duration-500 group-hover:translate-x-1"
              />
            )}
          </div>
        </span>
      </button>
    )
  }
</div>

<script>
  document.querySelectorAll('.animated-button').forEach((button) => {
    button.addEventListener('click', (e) => {
      const buttonId = button.getAttribute('data-button-id');

      const customEvent = new CustomEvent('animatedButtonClick', {
        detail: {
          timestamp: Date.now(),
          target: e.currentTarget,
          text: button.textContent?.trim(),
          buttonId: buttonId,
        },
        bubbles: true,
      });
      button.dispatchEvent(customEvent);
    });
  });
</script>
