---
// src/components/AnimatedButton.astro
interface Props {
  text?: string;
  href?: string;
  variant?: 'gradient' | 'primary' | 'secondary';
  size?: 'sm' | 'md' | 'lg';
  class?: string;
  icon?: any;
  iconPosition?: 'left' | 'right';
  showDefaultIcon?: boolean;
  type?: 'button' | 'submit' | 'reset';
  disabled?: boolean;
  id?: string;
}

const {
  text = "Let's get started",
  href,
  variant = 'gradient',
  size = 'md',
  class: className = '',
  icon: Icon,
  iconPosition = 'right',
  showDefaultIcon = true,
  type = 'button',
  disabled = false,
  id,
} = Astro.props;

// Variantes de gradiente
const gradients = {
  gradient: 'from-primary via-blue-500 to-secondary',
  primary: 'from-primary via-primary to-primary',
  secondary: 'from-secondary via-secondary to-secondary',
};

// Tamaños
const sizes = {
  sm: 'px-4 py-2 text-sm',
  md: 'px-6 py-3 text-base',
  lg: 'px-8 py-4 text-lg',
};

const iconSizes = {
  sm: 'w-4 h-4',
  md: 'w-5 h-5',
  lg: 'w-6 h-6',
};

const gradientClass = gradients[variant];
const sizeClass = sizes[size];
const iconSizeClass = iconSizes[size];

const showIcon = Icon || showDefaultIcon;
---

<div class={`relative group ${className}`}>
  {
    href ? (
      <a
        href={href}
        data-button-id={id}
        class={`animated-button relative inline-block p-px font-semibold leading-6 text-typography-secondary bg-border-color cursor-pointer rounded-xl transition-transform duration-300 ease-in-out hover:scale-105 active:scale-95 ${disabled ? 'pointer-events-none opacity-50' : ''}`}
        aria-disabled={disabled}
      >
        <span
          class={`absolute inset-0 rounded-xl bg-gradient-to-r ${gradientClass} p-[2px] opacity-0 transition-opacity duration-500 group-hover:opacity-100`}
        />

        <span class={`relative z-10 block rounded-xl bg-background-secondary ${sizeClass}`}>
          <div
            class={`relative z-10 flex items-center justify-center space-x-2 ${iconPosition === 'left' ? 'flex-row-reverse space-x-reverse' : ''}`}
          >
            <span class="transition-all duration-500 group-hover:translate-x-1">{text}</span>
            {showIcon &&
              (Icon ? (
                <Icon
                  class={`${iconSizeClass} transition-transform duration-500 group-hover:translate-x-1`}
                />
              ) : (
                <svg
                  class={`${iconSizeClass} transition-transform duration-500 group-hover:translate-x-1`}
                  aria-hidden="true"
                  fill="currentColor"
                  viewBox="0 0 20 20"
                  xmlns="http://www.w3.org/2000/svg"
                >
                  <path
                    clip-rule="evenodd"
                    d="M8.22 5.22a.75.75 0 0 1 1.06 0l4.25 4.25a.75.75 0 0 1 0 1.06l-4.25 4.25a.75.75 0 0 1-1.06-1.06L11.94 10 8.22 6.28a.75.75 0 0 1 0-1.06Z"
                    fill-rule="evenodd"
                  />
                </svg>
              ))}
          </div>
        </span>
      </a>
    ) : (
      <button
        type={type}
        disabled={disabled}
        data-button-id={id}
        class={`animated-button relative inline-block p-px font-semibold leading-6 text-typography-secondary bg-border-color cursor-pointer rounded-xl transition-transform duration-300 ease-in-out hover:scale-105 active:scale-95 ${disabled ? 'cursor-not-allowed opacity-50' : ''}`}
      >
        <span
          class={`absolute inset-0 rounded-xl bg-linear-to-r ${gradientClass} p-0.5 opacity-0 transition-opacity duration-500 group-hover:opacity-100`}
        />

        <span class={`relative z-10 block rounded-xl bg-background-secondary ${sizeClass}`}>
          <div
            class={`relative z-10 flex items-center justify-center space-x-2 ${iconPosition === 'left' ? 'flex-row-reverse space-x-reverse' : ''}`}
          >
            <span class="transition-all duration-500 group-hover:translate-x-1">{text}</span>
            {showIcon &&
              (Icon ? (
                <Icon
                  class={`${iconSizeClass} transition-transform duration-500 group-hover:translate-x-1`}
                />
              ) : (
                <svg
                  class={`${iconSizeClass} transition-transform duration-500 group-hover:translate-x-1`}
                  aria-hidden="true"
                  fill="currentColor"
                  viewBox="0 0 20 20"
                  xmlns="http://www.w3.org/2000/svg"
                >
                  <path
                    clip-rule="evenodd"
                    d="M8.22 5.22a.75.75 0 0 1 1.06 0l4.25 4.25a.75.75 0 0 1 0 1.06l-4.25 4.25a.75.75 0 0 1-1.06-1.06L11.94 10 8.22 6.28a.75.75 0 0 1 0-1.06Z"
                    fill-rule="evenodd"
                  />
                </svg>
              ))}
          </div>
        </span>
      </button>
    )
  }
</div>

<script>
  document.querySelectorAll('.animated-button').forEach((button) => {
    button.addEventListener('click', (e) => {
      const buttonId = button.getAttribute('data-button-id');

      // Dispatch custom event
      const customEvent = new CustomEvent('animatedButtonClick', {
        detail: {
          timestamp: Date.now(),
          target: e.currentTarget,
          text: button.textContent?.trim(),
          buttonId: buttonId,
        },
        bubbles: true,
      });
      button.dispatchEvent(customEvent);
    });
  });
</script>
