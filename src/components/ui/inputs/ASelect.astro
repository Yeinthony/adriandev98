---
// src/components/Select.astro

interface Props {
  items: any[];
  titleKey?: string;
  valueKey?: string;
  size?: 'sm' | 'md' | 'lg';
  placeholder?: string;
  class?: string;
  id?: string;
  name?: string;
  required?: boolean;
  disabled?: boolean;
  defaultValue?: string;
}

const {
  items = [],
  titleKey = 'title',
  valueKey = 'value',
  size = 'md',
  placeholder = 'Select an option',
  class: className = '',
  id,
  name,
  required = false,
  disabled = false,
  defaultValue,
} = Astro.props;

// Tamaños
const sizes = {
  sm: 'px-3 py-1.5 text-sm',
  md: 'px-4 py-2.5 text-base',
  lg: 'px-5 py-3 text-lg',
};

const sizeClass = sizes[size];

// Función helper para obtener el valor de un item
const getItemValue = (item: any, key: string) => {
  if (typeof item === 'string' || typeof item === 'number') {
    return item;
  }
  return item[key];
};
---

<div class={`relative ${className}`}>
  <select
    id={id}
    name={name}
    required={required}
    disabled={disabled}
    data-select
    class={`
      custom-select
      w-full
      ${sizeClass}
      rounded-xl
      border-2
      border-border-color
      bg-background-secondary
      text-typography-primary
      font-medium
      appearance-none
      cursor-pointer
      transition-all
      duration-200
      focus:outline-none
      focus:border-primary
      focus:ring-2
      focus:ring-primary/20
      hover:border-primary/50
      disabled:cursor-not-allowed
      disabled:opacity-50
      disabled:hover:border-border-color
    `}
  >
    <option value="" disabled selected={!defaultValue}>
      {placeholder}
    </option>
    {
      items.map((item) => {
        const value = getItemValue(item, valueKey);
        const title = getItemValue(item, titleKey);
        return (
          <option value={value} selected={defaultValue === value}>
            {title}
          </option>
        );
      })
    }
  </select>

  <!-- Icono de flecha personalizado -->
  <div
    class="pointer-events-none absolute inset-y-0 right-0 flex items-center pr-3 text-typography-secondary"
  >
    <svg
      class="h-5 w-5 transition-transform duration-200"
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 20 20"
      fill="currentColor"
      aria-hidden="true"
    >
      <path
        fill-rule="evenodd"
        d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z"
        clip-rule="evenodd"></path>
    </svg>
  </div>
</div>

<script>
  document.querySelectorAll('[data-select]').forEach((select) => {
    select.addEventListener('change', (e) => {
      const target = e.target as HTMLSelectElement;
      const selectedOption = target.options[target.selectedIndex];

      // Dispatch custom event
      const customEvent = new CustomEvent('selectChange', {
        detail: {
          value: target.value,
          text: selectedOption.text,
          selectedIndex: target.selectedIndex,
          selectId: target.id,
          selectName: target.name,
          timestamp: Date.now(),
        },
        bubbles: true,
      });
      select.dispatchEvent(customEvent);
    });

    // También puedes escuchar el evento focus
    select.addEventListener('focus', (e) => {
      const target = e.target as HTMLSelectElement;
      const customEvent = new CustomEvent('selectFocus', {
        detail: {
          selectId: target.id,
          selectName: target.name,
          timestamp: Date.now(),
        },
        bubbles: true,
      });
      select.dispatchEvent(customEvent);
    });
  });
</script>

<style>
  /* Ocultar la flecha nativa del select */
  .custom-select {
    background-image: none;
  }

  .custom-select::-ms-expand {
    display: none;
  }
</style>
